# External packages used by the API, worker, and Qdrant/vector CI checks.
# Local projects are installed separately with --no-deps after this file is
# locked; their maintainable dependency declarations remain in pyproject.toml.
-r requirements.lock
# PyTorch publishes these Linux CUDA dependencies as platform-marked
# transitive requirements. Keep the reviewed versions explicit so the
# --require-hashes CI install is complete on Ubuntu as well as macOS.
nvidia-cublas-cu12==12.6.4.1; platform_system == "Linux" and platform_machine == "x86_64"
nvidia-cuda-cupti-cu12==12.6.80; platform_system == "Linux" and platform_machine == "x86_64"
