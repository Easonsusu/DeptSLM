# External dependencies for vector/model worker images. The local API and
# worker packages are installed separately with --no-deps.
-r ../../apps/api/requirements-worker.lock
# PyTorch's Linux CUDA wheels are platform-marked transitive requirements;
# keep the reviewed versions explicit for complete hash locking.
