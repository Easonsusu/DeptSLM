# Create .env without widening permissions: umask 077; cp .env.example .env;
# chmod 600 .env. Replace this value with the path printed by
# scripts/setup_google_drive_storage.sh. Never overwrite an existing .env.
# DeptSLM must not write persistent runtime data inside the repository.
DEPTSLM_DATA_DIR="/absolute/path/to/GoogleDrive/My Drive/DeptSLM"
DEPTSLM_DOCUMENT_MAX_BYTES="26214400"
DEPTSLM_DEPARTMENT_DOCUMENT_QUOTA_BYTES="1073741824"

# Phase 5 extraction worker limits. The lease must exceed the timeout by at
# least 30 seconds; overlap must not exceed half the chunk size.
DEPTSLM_EXTRACTION_TIMEOUT_SECONDS="120"
DEPTSLM_MAX_EXTRACTED_BYTES="104857600"
DEPTSLM_MAX_PDF_PAGES="1000"
DEPTSLM_CHUNK_MAX_CHARS="1200"
DEPTSLM_CHUNK_OVERLAP_CHARS="200"
DEPTSLM_MAX_CHUNKS_PER_DOCUMENT="100000"
DEPTSLM_EXTRACTION_LEASE_SECONDS="300"
DEPTSLM_WORKER_POLL_SECONDS="5"
DEPTSLM_DEPARTMENT_EXTRACTED_QUOTA_BYTES="4294967296"

# This Compose-internal URL uses the service hostname "postgres". Commands run
# directly on the host must instead use a host-accessible URL with localhost.
DATABASE_URL="postgresql+psycopg://deptslm:deptslm@postgres:5432/deptslm"
API_PORT=8000
WEB_PORT=3000
ENVIRONMENT="development"

# Development/test authentication only. HS256 requires ENVIRONMENT to be one of
# local, development, dev, or test. Generate a local uncommitted secret with:
# python -c 'import secrets; print(secrets.token_urlsafe(48))'
# Keep the generated value only in the untracked local .env file. Compose passes
# these authentication settings only to the API container.
DEPTSLM_AUTH_MODE="disabled"
DEPTSLM_AUTH_ISSUER="https://issuer.example.invalid"
DEPTSLM_AUTH_AUDIENCE="deptslm-local"
DEPTSLM_AUTH_SECRET=""

# Phase 6 indexing only. Generate a long local API key and keep it only in the
# untracked .env file. The model preparation command may additionally read an
# untracked HF_TOKEN, but ordinary workers never receive it or use the network.
DEPTSLM_QDRANT_URL="http://qdrant:6333"
DEPTSLM_QDRANT_API_KEY=""
DEPTSLM_QDRANT_COLLECTION="deptslm_chunks_qwen3_0_6b_1024_v1"
DEPTSLM_QDRANT_TIMEOUT_SECONDS="30"
DEPTSLM_VECTOR_INDEX_LEASE_SECONDS="300"
DEPTSLM_VECTOR_INDEX_POLL_SECONDS="5"
DEPTSLM_EMBEDDING_BATCH_SIZE="8"
DEPTSLM_EMBEDDING_MAX_BATCH_CHARS="8192"
DEPTSLM_EMBEDDING_TIMEOUT_SECONDS="120"
DEPTSLM_EMBEDDING_MODEL_REVISION="d23109d65ca9fdf61eef614209744716f337f50f"
DEPTSLM_EMBEDDING_PROVIDER="real"

# Phase 7 one-turn grounded answers. Generate a separate long runtime token;
# keep both tokens only in the untracked .env file. The 0.45 threshold is
# provisional until Phase 9 evaluation.
DEPTSLM_RAG_RUNTIME_URL="http://rag-runtime:8010"
DEPTSLM_RAG_RUNTIME_TOKEN=""
# Phase 12.2 candidate runtime token; keep it distinct and untracked.
DEPTSLM_ADAPTER_EVAL_RUNTIME_TOKEN=""
# Phase 12.4 production adapter generation is a separate private runtime. Use
# a token distinct from both DEPTSLM_RAG_RUNTIME_TOKEN and the evaluator token.
DEPTSLM_ADAPTER_RUNTIME_URL="http://adapter-runtime:8012"
DEPTSLM_ADAPTER_RUNTIME_TOKEN=""
DEPTSLM_ADAPTER_RUNTIME_PROVIDER="real"
DEPTSLM_RAG_RUNTIME_PROVIDER="real"
DEPTSLM_RAG_RUNTIME_MAX_CONCURRENCY="1"
DEPTSLM_GENERATION_MODEL_REVISION="c1899de289a04d12100db370d81485cdf75e47ca"
DEPTSLM_RAG_CANDIDATE_LIMIT="20"
DEPTSLM_RAG_MAX_SOURCES="8"
DEPTSLM_RAG_MAX_SOURCES_PER_DOCUMENT="2"
DEPTSLM_RAG_MAX_EVIDENCE_CHARS="6000"
DEPTSLM_RAG_MIN_SCORE="0.45"
DEPTSLM_RAG_REQUEST_TIMEOUT_SECONDS="30"
# The API envelope is separate from the Phase 7 timeout and covers the
# adapter runtime's 300-second target-load and 120-second generation clocks
# plus a fixed transport margin. Reviewed bounds: 450 through 600 seconds.
DEPTSLM_ADAPTER_RUNTIME_REQUEST_TIMEOUT_SECONDS="450"

# Phase 8 structured feedback metadata. Existing rows retain the expiry fixed
# at submission even if this setting changes later.
DEPTSLM_RAG_FEEDBACK_RETENTION_DAYS="180"

# Phase 9 internal evaluation control plane. Use a unique non-zero worker UUID
# and the exact lowercase 40-character Git revision deployed to both API and
# evaluator. The evaluator reuses the Phase 7 Qdrant/runtime settings above.
DEPTSLM_EVALUATION_WORKER_ID="00000000-0000-0000-0000-000000000009"
DEPTSLM_EVALUATION_POLL_SECONDS="5"
DEPTSLM_EVALUATION_LEASE_SECONDS="300"
DEPTSLM_EVALUATION_HEARTBEAT_SECONDS="30"
DEPTSLM_EVALUATION_OPERATION_TIMEOUT_SECONDS="120"
DEPTSLM_EVALUATION_CODE_REVISION=""

# Phase 10 SFT dataset-builder metadata only. This worker writes solely to the
# external training_datasets directory and never loads/downloads a model.
DEPTSLM_SFT_WORKER_ID="00000000-0000-0000-0000-000000000010"
DEPTSLM_SFT_POLL_SECONDS="5"
DEPTSLM_SFT_LEASE_SECONDS="300"
DEPTSLM_SFT_CODE_REVISION=""
DEPTSLM_SFT_RETENTION_DAYS="180"

# Phase 11 writes reviewed LlamaFactory job bundles only. It never installs or
# invokes LlamaFactory, loads a model, or writes adapters. The separate worker
# receives only PostgreSQL metadata and external training_datasets storage.
DEPTSLM_TRAINING_JOB_WORKER_ID="00000000-0000-0000-0000-000000000011"
DEPTSLM_TRAINING_JOB_POLL_SECONDS="5"
DEPTSLM_TRAINING_JOB_LEASE_SECONDS="300"
DEPTSLM_TRAINING_JOB_OPERATION_SECONDS="120"
DEPTSLM_TRAINING_JOB_CODE_REVISION=""
DEPTSLM_TRAINING_JOB_RETENTION_DAYS="180"

# Phase 14.2 private offline real-training runtime. These values are required
# only when the opt-in Compose `training` profile is enabled. The lock and
# environment fingerprints are content-free provenance; keep the token only in
# the untracked .env file and never reuse another runtime secret.
DEPTSLM_TRAINING_EXECUTION_CODE_REVISION=""
DEPTSLM_TRAINING_DEPENDENCY_LOCK_SHA256="a8d07eb3c07a1f3e13027f8d39b496fbb659dfb22e9e40a60fbeecc529cea786"
DEPTSLM_TRAINING_ENVIRONMENT_PROFILE_ID="deptslm-phase14-training-runtime-linux-x86_64-cuda126-v1"
DEPTSLM_TRAINING_ENVIRONMENT_FINGERPRINT="3c32b171e730190d0ff1096ec1dcce7aad943e09f48c5e36eb99f8fd1e599d14"
DEPTSLM_TRAINING_RUNTIME_TOKEN=""

# Phase 12.1C immutable adapter registry publication. This worker consumes a
# claimed Phase 12.1B source plus the exact approved Phase 11 authority and
# publishes only the content-free registry contract. It never loads a model.
DEPTSLM_ADAPTER_REGISTRY_WORKER_ID="00000000-0000-0000-0000-000000000012"
DEPTSLM_ADAPTER_REGISTRY_POLL_SECONDS="5"
DEPTSLM_ADAPTER_REGISTRY_LEASE_SECONDS="300"
DEPTSLM_ADAPTER_REGISTRY_OPERATION_SECONDS="600"
DEPTSLM_ADAPTER_REGISTRY_CODE_REVISION=""

# Phase 12.1E-B manual adapter-artifact purge. The command is dry-run by
# default; --apply is required for mutation. Bounds are intentionally small.
DEPTSLM_ADAPTER_PURGE_MAX_OPERATIONS="1"
DEPTSLM_ADAPTER_PURGE_MAX_ITEMS="2"
